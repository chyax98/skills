          <mxGeometry x="250" y="50" width="90" height="70" as="geometry"/>
        </mxCell>

        <!-- ========== 私有子网 - 数据层 ========== -->
        <mxCell id="private_data_subnet" value="Private Subnet - Data (10.0.3.0/24)"
