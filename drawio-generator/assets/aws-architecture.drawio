        <mxCell id="ec2_2" value="EC2&#xa;(t3.medium)"
                style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FF9900;gradientColor=#FF6600;strokeColor=#CC6600;strokeWidth=2;fontColor=#ffffff;fontSize=10;shadow=1;"
                vertex="1" parent="asg">
          <mxGeometry x="140" y="50" width="90" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ec2_3" value="EC2&#xa;(t3.medium)"
                style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FF9900;gradientColor=#FF6600;strokeColor=#CC6600;strokeWidth=2;fontColor=#ffffff;fontSize=10;shadow=1;"
