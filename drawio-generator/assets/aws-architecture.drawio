                vertex="1" parent="services_area">
          <mxGeometry x="200" y="320" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- ========== 连线 ========== -->
        <!-- 用户到 CDN -->
        <mxCell id="e_user_cdn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;"
