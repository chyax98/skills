<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Claude Code">
  <diagram name="AWS Architecture" id="aws-arch">
    <mxGraphModel dx="1400" dy="1000" grid="1" page="1" pageWidth="1400" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ========== 标题 ========== -->
        <mxCell id="title" value="AWS Three-Tier Architecture"
                style="text;html=1;fontSize=20;fontStyle=bold;align=center;fillColor=none;strokeColor=none;"
                vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="400" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== 用户/CDN 层 ========== -->
        <mxCell id="users" value="Users"
                style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#333333;"
                vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="40" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="cloudfront" value="CloudFront&#xa;CDN"
                style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FF9900;gradientColor=#FF6600;gradientDirection=south;strokeColor=#CC6600;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=bold;shadow=1;shadowColor=#333333;shadowOpacity=0.3;"
                vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="route53" value="Route 53&#xa;DNS"
                style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#8C4FFF;gradientColor=#6B3ACC;gradientDirection=south;strokeColor=#5A2D99;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=bold;shadow=1;"
                vertex="1" parent="1">
          <mxGeometry x="250" y="180" width="120" height="50" as="geometry"/>
        </mxCell>

        <!-- ========== VPC 边界 ========== -->
        <mxCell id="vpc" value="VPC (10.0.0.0/16)"
