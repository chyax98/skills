          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CDN 到 Route53 -->
        <mxCell id="e_cdn_r53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;"
                edge="1" parent="1" source="cloudfront" target="route53">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Route53 到 ALB -->
        <mxCell id="e_r53_alb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;"
                edge="1" parent="1" source="route53" target="alb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ALB 到 EC2 -->
        <mxCell id="e_alb_ec2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9900;strokeWidth=2;endArrow=block;endFill=1;"
