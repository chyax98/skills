{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/test-case.schema.json",
  "title": "TestCase",
  "description": "测试用例 Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "module_name",
    "test_point_name",
    "priority",
    "test_type",
    "is_negative",
    "preconditions",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TC-[0-9]{3,4}$",
      "description": "用例 ID，格式：TC-序号，例如：TC-001、TC-0012"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "用例名称，按主谓宾格式表达，例如：验证用户成功登录系统"
    },
    "module_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "description": "测试项（被测对象/模块），简洁表达，例如：用户登录、订单管理"
    },
    "test_point_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "description": "测试场景，例如：正常登录流程、密码错误处理"
    },
    "priority": {
      "type": "string",
      "enum": ["P1", "P2", "P3", "P4", "P5"],
      "description": "优先级：P1（核心功能正向）、P2（基本功能正向）、P3（核心功能反向）、P4（基本功能反向）、P5（不常用功能）"
    },
    "test_type": {
      "type": "string",
      "enum": [
        "功能测试",
        "易用性测试",
        "兼容性测试",
        "性能测试",
        "安全性测试",
        "稳定性测试",
        "集成测试",
        "可靠性测试",
        "可维护性测试",
        "可移植性测试",
        "埋点测试",
        "AI效果测试",
        "硬件效果测试"
      ],
      "description": "测试类型"
    },
    "is_negative": {
      "type": "boolean",
      "description": "是否为反向用例（异常、边界测试）"
    },
    "preconditions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "前置条件列表"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["action", "expected"],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "操作步骤"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "预期结果"
          }
        },
        "additionalProperties": false
      },
      "description": "测试步骤列表，每个步骤包含 action 和 expected"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "备注说明（可选）"
    }
  },
  "additionalProperties": false
}
