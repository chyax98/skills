{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/test-item.schema.json",
  "title": "ModuleTestItems",
  "description": "模块测试项 Schema（轻量级，按模块分组）",
  "type": "object",
  "required": [
    "module_id",
    "module_name",
    "test_items",
    "prd"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^M[0-9]{2}$",
      "description": "模块 ID，格式：M01-M99"
    },
    "module_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "description": "功能模块名称，≤15 字符"
    },
    "test_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["item", "business_value"],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "测试项名称"
          },
          "business_value": {
            "type": "string",
            "enum": ["高", "中", "低"],
            "description": "业务价值：高（核心流程）、中（辅助功能）、低（边缘功能）"
          }
        },
        "additionalProperties": false
      },
      "description": "该模块的所有测试项"
    },
    "prd": {
      "type": "string",
      "minLength": 1,
      "description": "该模块的需求详情（完整内容）"
    }
  },
  "additionalProperties": false
}
